DATABASE_URL=postgresql://user:password@localhost:5432/hostelsense
SECRET_KEY=replace-with-a-long-random-value
APP_ENV=development
ADMIN_SETUP_KEY=replace-with-a-one-time-bootstrap-key
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
FACE_SERVICE_URL=http://127.0.0.1:5001
FACE_SERVICE_TOKEN=replace-with-a-shared-service-token
SESSION_COOKIE_SECURE=1
RESET_TOKEN_MINUTES=10
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=1
MAIL_FROM=no-reply@example.com
